{
  "name": "roseland-journal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "shopify app dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma db push",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env scripts/sync-worker.mjs",
    "verify:feed": "node scripts/verify-feed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@remix-run/node": "^2.17.0",
    "@remix-run/react": "^2.17.0",
    "@remix-run/serve": "^2.17.0",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-app-remix": "^3.8.0",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.0",
    "@shopify/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "linkedom": "^0.18.14",
    "liquidjs": "^10.30.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0"
  }
}
